<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.instser.chat.dao.ChatMessageDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.instser.chat.entity.ChatMessage">
        <id column="id" property="id" />
        <result column="message_id" property="messageId" />
        <result column="session_id" property="sessionId" />
        <result column="role" property="role" />
        <result column="content" property="content" />
        <result column="message_type" property="messageType" />
        <result column="has_attachments" property="hasAttachments" />
        <result column="user_id" property="userId" />
        <result column="model_id" property="modelId" />
        <result column="token_count" property="tokenCount" />
        <result column="status" property="status" />
        <result column="error_message" property="errorMessage" />
        <result column="create_time" property="createdTime" />
        <result column="update_time" property="updateTime" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, message_id, session_id, role, content, message_type, has_attachments, user_id, model_id, token_count, status, error_message, create_time, update_time, deleted
    </sql>

    <!-- 根据会话ID查询消息列表 -->
    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_chat_message
        WHERE session_id = #{sessionId}
          AND deleted = 0
        ORDER BY create_time ASC
    </select>

    <!-- 根据用户ID查询最近的消息 -->
    <select id="selectRecentByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_chat_message
        WHERE user_id = #{userId}
          AND deleted = 0
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

    <!-- 根据消息ID查询消息 -->
    <select id="selectByMessageId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_chat_message
        WHERE message_id = #{messageId}
          AND deleted = 0
        LIMIT 1
    </select>

</mapper>
