# Stripe测试环境配置
# 请替换为你从Stripe Dashboard获取的真实测试密钥

# Stripe测试公钥（从 https://dashboard.stripe.com/test/apikeys 获取）
STRIPE_PUBLIC_KEY=pk_test_请替换为你的真实测试公钥

# Stripe测试私钥（从 https://dashboard.stripe.com/test/apikeys 获取）
STRIPE_SECRET_KEY=sk_test_请替换为你的真实测试私钥

# Stripe测试Webhook密钥（从 https://dashboard.stripe.com/test/webhooks 获取）
STRIPE_WEBHOOK_SECRET=whsec_请替换为你的真实测试webhook密钥

# 测试环境标识
STRIPE_SANDBOX=true
STRIPE_CURRENCY=usd

# 使用说明：
# 1. 获取密钥后，替换上面的占位符
# 2. 重命名文件为 .env
# 3. 确保 .env 文件在 .gitignore 中，不要提交到代码仓库